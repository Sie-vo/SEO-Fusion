# .htaccess File für SEO-Fusion
RewriteEngine On
RewriteBase /

# If request targets an existing file or directory, serve it directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Otherwise forward the request to the SEO router
RewriteRule ^(.*)$ seo-router.php?slug=$1 [L,QSA]